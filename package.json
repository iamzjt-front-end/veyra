{
  "name": "veyra-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Veyra — one goal, many agents, verified execution.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "biome lint --error-on-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "TURBO_TELEMETRY_DISABLED=1 turbo build",
    "dev": "TURBO_TELEMETRY_DISABLED=1 turbo dev --parallel",
    "check": "TURBO_TELEMETRY_DISABLED=1 turbo check && tsc -p tsconfig.test.json && tsc -p tsconfig.scripts.json",
    "test": "TURBO_TELEMETRY_DISABLED=1 turbo test --concurrency=1 && vitest run --config vitest.config.ts",
    "smoke:live": "pnpm build && tsx test/smoke/manual-smoke.ts",
    "packages:check": "pnpm build && vitest run --config vitest.config.ts test/packaging.test.ts",
    "clean": "TURBO_TELEMETRY_DISABLED=1 turbo clean && rm -rf node_modules",
    "ve": "tsx apps/cli/src/index.ts",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only && pnpm format",
    "versioning:check": "vitest run --config vitest.config.ts test/versioning.test.ts",
    "release:check": "node scripts/release.mjs check",
    "release:pack": "node scripts/release.mjs pack",
    "release-ci:check": "vitest run --config vitest.config.ts test/release.test.ts",
    "installation:check": "pnpm build && node scripts/verify-install.mjs",
    "evaluate": "pnpm build && tsx test/evaluation/manual-evaluation.ts",
    "telemetry:check": "TURBO_TELEMETRY_DISABLED=1 turbo telemetry status"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@changesets/cli": "2.31.1",
    "@types/node": "^22.10.0",
    "@veyraoss/protocol": "workspace:*",
    "prettier": "3.9.6",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
