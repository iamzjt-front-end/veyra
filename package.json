{
  "name": "veyra-monorepo",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "Veyra — one goal, many agents, verified execution.",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "biome lint --error-on-warnings .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "check": "turbo check && tsc -p tsconfig.test.json",
    "test": "turbo test && vitest run --config vitest.config.ts",
    "clean": "turbo clean && rm -rf node_modules",
    "ve": "tsx apps/cli/src/index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^22.10.0",
    "@veyra/protocol": "workspace:*",
    "prettier": "3.9.6",
    "tsx": "^4.19.0",
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.0"
  }
}
