{
  "name": "@veyra/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "ve": "./dist/index.js"
  },
  "dependencies": {
    "@veyra/core": "workspace:*",
    "@veyra/config": "workspace:*",
    "@veyra/protocol": "workspace:*",
    "@veyra/runtime": "workspace:*",
    "@veyra/workflow": "workspace:*",
    "@veyra/codex": "workspace:*",
    "@veyra/openai": "workspace:*",
    "yaml": "2.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "clean": "rm -rf dist"
  }
}
