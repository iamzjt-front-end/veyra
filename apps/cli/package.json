{
  "name": "@veyraoss/cli",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "ve": "./dist/index.js"
  },
  "dependencies": {
    "@veyraoss/core": "workspace:*",
    "@veyraoss/config": "workspace:*",
    "@veyraoss/protocol": "workspace:*",
    "@veyraoss/runtime": "workspace:*",
    "@veyraoss/sdk": "workspace:*",
    "@veyraoss/workflow": "workspace:*",
    "@veyraoss/codex": "workspace:*",
    "@veyraoss/claude": "workspace:*",
    "@veyraoss/claude-code": "workspace:*",
    "@veyraoss/gemini": "workspace:*",
    "@veyraoss/openai": "workspace:*",
    "@veyraoss/opencode": "workspace:*",
    "yaml": "2.9.0",
    "@veyraoss/project": "workspace:*",
    "@veyraoss/daemon": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests --maxWorkers=4",
    "smoke:native": "tsx test/manual-native-dispatch.ts",
    "clean": "rm -rf dist"
  },
  "description": "The Veyra command-line application, exposed as ve.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamzjt-front-end/veyra.git",
    "directory": "apps/cli"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {},
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
