{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:veyra:workflow:1",
  "title": "Veyra Workflow version 1",
  "description": "Structural validation for the implemented Workflow DSL. Use parseWorkflow/loadWorkflow as well to check start and transition destinations. Reserved node types are rejected until implemented.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version", "start", "steps"],
  "properties": {
    "name": {
      "$ref": "#/definitions/text"
    },
    "version": {
      "const": 1
    },
    "start": {
      "$ref": "#/definitions/text"
    },
    "steps": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "$ref": "#/definitions/text"
      },
      "additionalProperties": {
        "oneOf": [
          {
            "$ref": "#/definitions/agent"
          },
          {
            "$ref": "#/definitions/command"
          },
          {
            "$ref": "#/definitions/human"
          },
          {
            "$ref": "#/definitions/end"
          },
          {
            "$ref": "#/definitions/parallel"
          },
          {
            "$ref": "#/definitions/router"
          },
          {
            "$ref": "#/definitions/subworkflow"
          },
          {
            "$ref": "#/definitions/consensus"
          }
        ]
      }
    }
  },
  "definitions": {
    "text": {
      "type": "string",
      "pattern": "\\S"
    },
    "on": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/definitions/text"
      },
      "additionalProperties": {
        "$ref": "#/definitions/text"
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max"],
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      }
    },
    "metadata": {
      "description": "JSON-compatible annotations, not execution instructions or a credential store.",
      "type": "object",
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "agent"],
      "properties": {
        "type": {
          "const": "agent"
        },
        "agent": {
          "$ref": "#/definitions/text"
        },
        "next": {
          "$ref": "#/definitions/text"
        },
        "on": {
          "$ref": "#/definitions/on"
        },
        "retry": {
          "$ref": "#/definitions/retry"
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        },
        "inputs": {
          "$ref": "#/definitions/inputs"
        }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "run"],
      "properties": {
        "type": {
          "const": "command"
        },
        "run": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "next": {
          "$ref": "#/definitions/text"
        },
        "on": {
          "$ref": "#/definitions/on"
        },
        "retry": {
          "$ref": "#/definitions/retry"
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        }
      }
    },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "human"
        },
        "message": {
          "$ref": "#/definitions/text"
        },
        "next": {
          "$ref": "#/definitions/text"
        },
        "on": {
          "$ref": "#/definitions/on"
        },
        "retry": {
          "$ref": "#/definitions/retry"
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        },
        "inputs": {
          "$ref": "#/definitions/inputs"
        }
      }
    },
    "end": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "end"
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        }
      }
    },
    "inputs": {
      "type": "object",
      "maxProperties": 16,
      "propertyNames": {
        "type": "string",
        "pattern": "\\S",
        "maxLength": 128
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "path"],
        "properties": {
          "from": {
            "$ref": "#/definitions/text"
          },
          "path": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^(?:/(?:[^~/]|~[01])*){0,32}(?![\\s\\S])"
          }
        }
      }
    },
    "subworkflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "anyOf": [
        { "required": ["use"], "properties": { "use": {} } },
        { "required": ["workflow"], "properties": { "workflow": {} } }
      ],
      "properties": {
        "type": { "const": "subworkflow" },
        "use": { "$ref": "#/definitions/text" },
        "workflow": { "$ref": "#" },
        "inputs": { "$ref": "#/definitions/inputs" },
        "outputs": { "$ref": "#/definitions/inputs" },
        "next": { "$ref": "#/definitions/text" },
        "on": { "$ref": "#/definitions/on" },
        "retry": { "$ref": "#/definitions/retry" },
        "metadata": { "$ref": "#/definitions/metadata" }
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "route", "on"],
      "properties": {
        "type": { "const": "router" },
        "route": {
          "oneOf": [
            { "type": "string", "pattern": "\\S", "maxLength": 128 },
            { "$ref": "#/definitions/inputs/additionalProperties" }
          ]
        },
        "on": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 32,
          "propertyNames": { "type": "string", "pattern": "\\S", "maxLength": 128 },
          "additionalProperties": { "$ref": "#/definitions/text" }
        },
        "next": { "$ref": "#/definitions/text" },
        "retry": { "$ref": "#/definitions/retry" },
        "metadata": { "$ref": "#/definitions/metadata" }
      }
    },
    "parallel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "children"],
      "properties": {
        "type": {
          "const": "parallel"
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "failurePolicy": {
          "enum": ["wait-all", "fail-fast"]
        },
        "next": {
          "$ref": "#/definitions/text"
        },
        "on": {
          "$ref": "#/definitions/on"
        },
        "retry": {
          "$ref": "#/definitions/retry"
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        }
      }
    },
    "consensus": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "reviewers"],
      "properties": {
        "type": {
          "const": "consensus"
        },
        "reviewers": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "mode": {
          "enum": ["all-pass", "quorum", "judge"]
        },
        "quorum": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "judge": {
          "$ref": "#/definitions/text"
        },
        "verification": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/definitions/text"
          }
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "next": {
          "$ref": "#/definitions/text"
        },
        "on": {
          "$ref": "#/definitions/on"
        },
        "retry": {
          "$ref": "#/definitions/retry"
        },
        "metadata": {
          "$ref": "#/definitions/metadata"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["mode"],
            "properties": {
              "mode": {
                "const": "quorum"
              }
            }
          },
          "then": {
            "required": ["quorum"],
            "properties": {
              "quorum": {}
            }
          },
          "else": {
            "properties": {
              "quorum": false
            }
          }
        },
        {
          "if": {
            "required": ["mode"],
            "properties": {
              "mode": {
                "const": "judge"
              }
            }
          },
          "then": {
            "required": ["judge"],
            "properties": {
              "judge": {}
            }
          },
          "else": {
            "properties": {
              "judge": false
            }
          }
        }
      ]
    }
  }
}
