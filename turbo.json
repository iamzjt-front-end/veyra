{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["test/helpers/**", "test/fixtures/**", "vitest.config.ts", "workflows/**"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "check": {
      "dependsOn": ["^build", "^check"]
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}
